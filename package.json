{
  "name": "notas-do-thiago",
  "version": "0.0.0",
  "private": true,
  "description": "Blog pessoal técnico em pt-BR — base do monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:types -- --watch",
    "build": "npm run build:types && npm run build:api && npm run build:web && npm run build:og && npm run build:pages",
    "build:types": "tsc -b --pretty false",
    "build:web": "npm run build --workspace @blog/web",
    "build:og": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json tsx scripts/og-image.ts",
    "build:pages": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json tsx scripts/prerender.ts && TSX_TSCONFIG_PATH=apps/web/tsconfig.json tsx scripts/feed.ts",
    "pretest": "npm run build:types",
    "test": "vitest run",
    "content:check": "tsx scripts/content-check.ts",
    "post:random": "tsx scripts/random-post.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:api": "npm run build -w apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
